# Public Appwrite endpoint and project ID only.
# Never place an Appwrite API key or server secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-only: comma-separated exact Appwrite user IDs authorized as Owner.
# Leave empty to deny all Admin access until the owner identity is verified.
ADMIN_OWNER_USER_IDS=

# Server-only secrets belong in the hosting provider's secret manager.
APPWRITE_API_KEY=
OPENAI_API_KEY=
