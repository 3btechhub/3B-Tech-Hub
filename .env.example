# Public Appwrite endpoint and project ID only.
# Never place an Appwrite API key or server secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6af42ac200285a12f46f
# Set this to the verified Appwrite Site hostname (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://3btechhub.appwrite.network

# Server-only: comma-separated exact Appwrite user IDs authorized as Owner.
# Use the verified Owner user ID from Appwrite; never guess this value.
ADMIN_OWNER_USER_IDS=
# Optional single-owner ID alias for managed Site variables.
ADMIN_OWNER_USER_ID=
ADMIN_OWNER_EMAIL=3btechhub@gmail.com

# Server-only secret. In Appwrite Sites, store this as a secret Site variable,
# never as a Global variable or in Git. The runtime's scoped x-appwrite-key
# header is preferred; this value is a fallback.
APPWRITE_API_KEY=

APPWRITE_SITE_API_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_SITE_PROJECT_ID=6af42ac200285a12f46f
APPWRITE_DATABASE_ID=3btechhub-prod
APPWRITE_CONTENT_TABLE_ID=content
APPWRITE_MEDIA_TABLE_ID=media_assets
APPWRITE_AUDIT_TABLE_ID=audit_logs
APPWRITE_SETTINGS_TABLE_ID=site_settings
APPWRITE_MEDIA_BUCKET_ID=media
OPENAI_API_KEY=
